+/* Views are also kept in a tree by base address: a process may have tens of
+ * thousands (a title that maps its physical pages one 64 KiB view each), and
+ * the lookups below walked the whole list on every map and unmap. Views never
+ * overlap (is_valid_view_addr), so the view at or below an address is the
+ * only one that can hold it. */
+static int compare_view_base( const void *key, const struct rb_entry *entry )
+{
+    client_ptr_t base = *(const client_ptr_t *)key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry );
+
+    if (base < view->base) return -1;
+    if (base > view->base) return 1;
+    return 0;
+}
+
+void init_process_view_tree( struct process *process )
+{
+    rb_init( &process->view_tree, compare_view_base );
+}
+
+/* the view with the highest base at or below addr, if any */
+static struct memory_view *find_view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct rb_entry *ptr = process->view_tree.root;
+    struct memory_view *found = NULL;
+
+    while (ptr)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( ptr, struct memory_view, tree_entry );
+        if (view->base <= addr)
+        {
+            found = view;
+            ptr = ptr->right;
+        }
+        else ptr = ptr->left;
+    }
+    return found;
+}
+
 /* find a memory view from its base address */
